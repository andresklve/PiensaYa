# Valores de desarrollo local. Copiar a .env (start-all.sh lo hace solo si falta).
# JWT_SECRET debe ser idéntico en los 5 servicios; en producción usar valores aleatorios.
PORT=3001
USER_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/piensaya_users"
JWT_SECRET="dev-jwt-secret-cambiar-en-produccion"
# Idéntico en auth-service y user-follow-service
INTERNAL_SERVICE_TOKEN="dev-internal-token-cambiar-en-produccion"
# Imágenes de perfil/portada: S3Mock en local (docker-compose)
STORAGE_ENDPOINT="http://localhost:9090"
STORAGE_BUCKET="piensaya-media"
STORAGE_REGION="us-east-1"
# En AWS: STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY, STORAGE_PUBLIC_URL
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_FEED_QUEUE="feed_events"
