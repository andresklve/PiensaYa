# Plantilla del stack de producción. Copiar a deploy/.env y completar:
#   cp .env.example .env && ./generate-secrets.sh >> .env
# deploy/.env está en .gitignore: nunca se sube al repo.

# --- Dominios: registros DNS A de ambos hacia la IP del servidor ---
# Direcciones de sitio de Caddy (con dominio real emite el certificado HTTPS solo).
APP_HOST=piensaya.example.com
API_HOST=api.piensaya.example.com
# URLs completas con las que el navegador llega a cada una (con https://).
PUBLIC_APP_URL=https://piensaya.example.com
PUBLIC_API_URL=https://api.piensaya.example.com

# --- Puertos del host (80/443 en un servidor real) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Secretos: se añaden con ./generate-secrets.sh >> .env ---
